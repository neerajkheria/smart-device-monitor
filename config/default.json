{
  "server": {
    "port": 3000,
    "env": "development"
  },
  "monitoring": {
    "telemetryIntervalMs": 60000,
    "voltageMinThreshold": 2.7,
    "criticalVoltageThreshold": 2.65,
    "nominalVoltage": 3.3,
    "batteryWindowMs": 300000,
    "batteryDegradedMinCount": 3,
    "temperatureMaxThreshold": 60.0,
    "psiMaxThreshold": 120.0
  },
  "logging": {
    "level": "info"
  }
}